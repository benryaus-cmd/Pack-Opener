{
  "name": "packverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8080",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8080",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "test:live": "node tests/live.mjs",
    "import:manifest": "node scripts/import-manifest.mjs",
    "test:social": "node tests/social.mjs",
    "format": "prettier --write src tests build scripts *.ts *.html *.json docs/*.md",
    "test:production": "node tests/production.mjs"
  },
  "dependencies": {
    "@aippy/runtime": "^0.4.1",
    "gsap": "^3.13.0",
    "howler": "^2.2.4",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/howler": "^2.2.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "ws": "^8.22.0"
  }
}
